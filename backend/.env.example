PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Amazon RDS (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=alhaja_app
DB_PASS=cambia_esto
DB_NAME=alhaja_joyeria
DB_SSL=false

JWT_SECRET=cambia_por_una_cadena_larga_y_aleatoria
TAX_RATE=0.16

# Amazon S3 (si S3_BUCKET está vacío, las imágenes se guardan en ./uploads solo para desarrollo)
S3_BUCKET=
AWS_REGION=us-west-2
# S3_PUBLIC_URL=https://dxxxx.cloudfront.net   (opcional, si usas CloudFront)

# Usuario administrador inicial (npm run seed)
ADMIN_EMAIL=admin@alhaja.mx
ADMIN_PASSWORD=Admin12345!
